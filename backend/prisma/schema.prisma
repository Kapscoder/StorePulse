// Prisma schema — MongoDB provider
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  normal_user
  store_owner
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  address   String?
  role      Role     @default(normal_user)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Store owner relation (store_owner has one store)
  ownedStore Store?

  // Ratings submitted by this user
  ratings   Rating[]

  @@index([email])
  @@index([name])
  @@map("users")
}

model Store {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  address   String?

  // Owner: a store_owner user linked to this store
  ownerId   String?  @unique @map("owner_id") @db.ObjectId
  owner     User?    @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  // Ratings for this store
  ratings   Rating[]

  @@index([name])
  @@map("stores")
}

model Rating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  storeId   String   @map("store_id") @db.ObjectId
  rating    Float    // 1.0 to 5.0 (decimals allowed e.g. 3.5)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId]) // one rating per user per store
  @@index([storeId])
  @@map("ratings")
}
